{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "deviceId",
    "platform",
    "arch",
    "memory"
  ],
  "properties": {
    "deviceId": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "arch": {
      "type": "string"
    },
    "memory": {
      "type": "object",
      "required": [
        "totalBytes"
      ],
      "properties": {
        "totalBytes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "freeBytes": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
